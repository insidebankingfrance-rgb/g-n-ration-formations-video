# Copie ce fichier en ".env" et remplis les valeurs (ne jamais committer le .env réel)

# Clé API D-ID (avatar parlant) — crée un compte gratuit sur https://www.d-id.com
# puis récupère ta clé dans Account Settings > API Keys.
D_ID_API_KEY=

# Voix utilisée pour la narration (voix Microsoft incluses gratuitement dans D-ID).
# Voir la liste complète des voix fr-FR dans README.md
D_ID_VOICE_ID=fr-FR-DeniseNeural

# Photo du présentateur virtuel (visage net, de face, bien éclairé).
# Chemin local vers une image dans assets/avatar/
AVATAR_IMAGE_PATH=assets/avatar/presentateur.jpg
